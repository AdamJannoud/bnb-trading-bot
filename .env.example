# Environment for bnb-trading-bot. The bot does not read this file itself:
# export these variables, or point your process manager / container at a copy.

# Fernet key that encrypts every stored wallet private key. Required.
# Keep it outside the database directory and back it up: without it, the
# stored wallets cannot be decrypted. Leave unset on the very first start and
# the bot prints a freshly generated key once, then exits.
WALLET_ENCRYPTION_KEY=
